# --- secrets -------------------------------------------------------------
# The shared HMAC key for the Tier 2 (Termux) transport. Committing this would let
# anything on the tailnet inject into or read your clipboard. Keep it local.
copyclip.key
*.key
!*.pub

# --- build output --------------------------------------------------------
# clipbridge.dex is generated from android/ClipBridge.java by android/build_dex.ps1.
# The Java source is tracked; the artifact is rebuilt in one command, and a stale
# committed dex is worse than none because it silently disagrees with the source.
bin/
*.dex
*.class

# --- reference clones ----------------------------------------------------
# otherCopyProjects holds shallow clones of upstream projects for reference. They carry
# their own .git directories, so committing them would create embedded repos. Track only
# the notes and the script that recreates them.
otherCopyProjects/*
!otherCopyProjects/NOTES.md
!otherCopyProjects/clone_all.ps1

# --- generated ------------------------------------------------------------
# graphify's knowledge-graph output (~516 KB, regenerated by `rtk graphify update .`)
graphify-out/

# --- runtime -------------------------------------------------------------
logs/
*.log

# Durable outbox: pending clipboard writes waiting for a device to come back.
# Machine-local state, and it can contain whatever you last copied.
state/

# --- python --------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- scratch -------------------------------------------------------------
# Base64 clipboard dumps made while testing. These can contain whatever was on your
# clipboard at the time, so they must never be committed.
*.b64

# --- android_app -----------------------------------------------------------
# local.properties hardcodes this machine's SDK path; build/ and .gradle/ are regenerated by
# gradlew. None of these belong in source control.
android_app/local.properties
android_app/**/build/
android_app/.gradle/
*.apk

# --- os / editor ---------------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store
.idea/
.vscode/
*.swp

# --- project tracking ----------------------------------------------------
PROJECT_TRACKER.md
